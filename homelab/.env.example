# =============================================================================
# KONFIGURASI BORNEO ETAM HOME LAB SERVER & 10TB STORAGE ARCHIVE
# Salin file ini menjadi .env di dalam folder homelab/ atau di root penawaran/
# =============================================================================

# Port server lokal (default 8787)
PORT=8787

# Lokasi fisik harddisk 10TB di komputer kantor
STORAGE_PATH=Z:\Storage10T\project aplikasi\apps build\penawaran\storage

# URL & Kunci Supabase
SUPABASE_URL=https://xukpisovkcflcwuhrzkx.supabase.co
# Kunci service_role diambil dari: Dashboard Supabase -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=

# Token Telegram Bot & Secret Token Webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Interval sinkronisasi otomatis foto & database (dalam detik, default 300 = 5 menit)
SYNC_INTERVAL_SECONDS=300
